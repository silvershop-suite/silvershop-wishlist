{
    "name": "silvershop/wishlist",
    "description": "Member wishlists for SilverShop: save products and variations for later, manage them in the account area, and move them to the cart.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silvershop",
        "ecommerce",
        "wishlist",
        "favourites"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop-suite/silvershop-wishlist/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/reports": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "php-http/guzzle7-adapter": "^1.1",
        "silvershop/stock": "^6",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "suggest": {
        "silvershop/stock": "Shows live availability (in stock / out of stock) for wishlist items."
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Wishlist\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Wishlist\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
